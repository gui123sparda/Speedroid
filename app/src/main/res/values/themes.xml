<resources>
    <style name="Theme.TunerStudioAndroid" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/speedroid_accent</item>
        <item name="colorPrimaryVariant">@color/speedroid_panel</item>
        <item name="colorOnPrimary">@color/speedroid_background</item>
        <item name="colorSecondary">@color/speedroid_accent</item>
        <item name="colorSurface">@color/speedroid_panel</item>
        <item name="colorOnSurface">@color/speedroid_text</item>
        <item name="colorError">@color/speedroid_error</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@color/speedroid_background</item>
